<mujoco model="bread-box_iiwa">
  <!-- KUKA iiwa 14 welded to the bread-box handle.
       Generated by scenes/build_scene.py - re-run it rather than hand-editing.

       Both models are pulled in with <attach> rather than copied, so the arm
       and the object stay single-sourced. The arm keeps its own names, the
       object is namespaced "obj_".

       Grasp configuration and weld: 12 random-restart damped-least-squares
       IK runs over 6 arm standoffs x 6 tool rolls, placing
       attachment_site on obj_handle with the tool axis along the lid's outward
       normal, scored on joint-limit margin and Jacobian conditioning. Winner:
       standoff 0.75 m, limit margin 0.913 rad, condition number 14.2. -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <!-- Contacts off: the weld already couples the arm to the lid, and letting
         the arm's collision geoms hit the object just fights the constraint. -->
    <flag contact="disable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="-125" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <model name="iiwa" file="../kuka_iiwa_14/iiwa14_torque.xml"/>
    <model name="object" file="../data/bread-box/object_static.xml"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="-0.16 -0.06 2.25" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="groundplane"/>

    <!-- Arm standing off the handle along the lid's outward normal. -->
    <body name="arm_mount" pos="-0.7079 -0.5699 0.0000">
      <attach model="iiwa" prefix=""/>
    </body>

    <body name="object_mount" pos="0 0 0">
      <attach model="object" prefix="obj_"/>
    </body>

    <camera name="scene_view" pos="-0.8748 -1.7782 0.9528" xyaxes="0.9240 -0.3824 0.0000 0.1344 0.3248 0.9362"/>
  </worldbody>

  <equality>
    <!-- MuJoCo's weld residual is
             (obj_lid.xpos + obj_lid.xmat @ anchor)
           - (link7.xpos   + link7.xmat   @ relpose_pos)
         so anchor and relpose_pos must name the SAME physical point in their two
         body frames - the handle. -->
    <weld name="ee_to_handle" body1="link7" body2="obj_lid"
          anchor="-0.16340000 0.11578000 0.15394000"
          relpose="0.00000000 0.00000001 0.04500003 0.50149190 -0.49850362 0.49850360 -0.50149194"
          solref="0.002 1" solimp="0.99 0.999 0.001 0.5 2"/>
  </equality>

  <!-- qpos: joint1..7 then obj_lid_hinge. Lid closed, EE on the handle. -->
  <keyframe>
    <key name="grasp" qpos="0.683726 1.148540 0.185694 -0.828182 -0.187715 1.181829 -0.737610 0.000000" ctrl="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
