<mujoco model="cabinet_iiwa">
  <!-- KUKA iiwa 14 welded to the kitchen-cabinet door handle.

       Both models are pulled in with <attach> rather than copied, so the arm
       and the cabinet stay single-sourced. The arm keeps its own names
       (prefix ""), the cabinet is namespaced "cab_".

       The grasp configuration and the weld below were solved offline by
       scenes/build_cabinet_scene.py: 200 random-restart damped-least-squares IK
       runs placing attachment_site on cab_handle with the tool z-axis pointing
       +y (head-on into the door face), scored on joint-limit margin and
       Jacobian conditioning. The winner has 0.234 rad of limit margin and a
       condition number of 6.9. Re-run the builder if you move the arm base. -->

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast">
    <!-- Contacts off: the weld already couples the arm to the door, and letting
         the arm's collision geoms hit the cabinet just fights the constraint.
         Nothing here rests on the floor - both bodies are anchored. -->
    <flag contact="disable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="-125" elevation="-20" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <model name="iiwa" file="../kuka_iiwa_14/iiwa14_torque.xml"/>
    <model name="cabinet" file="../data/kitchen-cabinet/object_static.xml"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 -1.5 2.5" dir="0 0.4 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="groundplane"/>

    <!-- Arm in front of the cabinet (-y side). 0.815 m from base origin to the
         handle, comfortably inside the 1.31 m maximum reach. -->
    <body name="arm_mount" pos="-0.30 -0.65 0">
      <attach model="iiwa" prefix=""/>
    </body>

    <body name="cab_mount" pos="0 0 0">
      <attach model="cabinet" prefix="cab_"/>
    </body>

    <camera name="scene_view" pos="-1.35 -1.75 1.55"
            xyaxes="0.78 -0.63 0 0.21 0.26 0.94"/>
  </worldbody>

  <equality>
    <!-- Rigid weld, flange to door, enforced at the handle rather than at the
         lid origin (which is the hinge).

         MuJoCo's weld residual is
             (cab_lid.xpos + cab_lid.xmat @ anchor)
           - (link7.xpos   + link7.xmat   @ relpose_pos)
         so anchor and relpose_pos must name the SAME physical point in their
         two body frames - the handle. relpose_pos comes out as (0, 0, 0.045),
         i.e. the attachment_site offset along the flange axis. -->
    <weld name="ee_to_handle" body1="link7" body2="cab_lid"
          anchor="-0.49851000 0.00228000 0.07446000"
          relpose="0 0 0.045 0 0 1 0"
          solref="0.002 1" solimp="0.99 0.999 0.001 0.5 2"/>
  </equality>

  <!-- qpos: joint1..7 then cab_lid_hinge. Door closed, EE on the handle. -->
  <keyframe>
    <key name="grasp"
         qpos="1.893315 1.808011 0.580434 1.860051 -0.143803 1.488430 1.013992 0.000000"
         ctrl="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
